{
  "id": null,
  "title": ".NET Application Metrics",
  "uid": "dotnet-app",
  "tags": ["dotnet", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "system_cpu_usage_percent",
          "legendFormat": "CPU Usage",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "Process CPU",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "system_memory_usage_bytes / 1024 / 1024",
          "legendFormat": "Memory Used (MB)",
          "refId": "A"
        },
        {
          "expr": "system_memory_available_bytes / 1024 / 1024",
          "legendFormat": "Memory Available (MB)",
          "refId": "B"
        },
        {
          "expr": "process_working_set_bytes / 1024 / 1024",
          "legendFormat": "Process Working Set (MB)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 2000 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
